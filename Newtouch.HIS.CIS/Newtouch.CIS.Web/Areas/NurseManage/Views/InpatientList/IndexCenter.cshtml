  @** 防抖
  * @param {Function} fn 要执行的函数
  * @param {Number} time 延迟时间(毫秒)
  * @param {Boolean} immediate 是否立即执行一次*@

    function debounce(fn, time, immediate) {
        let timer = null;
        return function () {
            const context = this;
            const args = arguments;

            if (timer) clearTimeout(timer);

            if (immediate && !timer) {
                fn.apply(context, args);
            }

            timer = setTimeout(() => {
                timer = null;
                if (!immediate) {
                    fn.apply(context, args);
                }
            }, time);
        };
    }

