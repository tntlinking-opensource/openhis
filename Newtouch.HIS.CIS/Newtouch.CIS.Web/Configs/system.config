<?xml version="1.0" encoding="utf-8"?>
<appSettings>
  <!-- ================== 1：开发系统相关配置 ================== -->
  <!-- 登录身份状态维持时间（单位：分）-->
  <add key="LoginStatusKeepMinute" value="3000" />
  <!-- 多终端互踢 -->
  <add key="EnableMultipleLoginLimit" value="true" />
  <!-- 多终端互踢-同一账号，最大同时在线数 -->
  <add key="MultipleLoginLimit_Count" value="10" />

  <!--启用IP过滤（启用后 启用IP访问限制策略（仅对部分开放 或 部分限制访问）） -->
  <add key="Is_IPFilter" value="false" />

  <!-- ================== 2：系统软件参数配置 ================== -->
  <!-- 软件版本 -->
  <add key="Version" value="1.00.00.00" />

  <!-- 关键部分Module Id配置 -->
  <!-- Reids缓存的key前缀 -->
  <add key="Reids_Cache_Prefix" value="$C_CIS$"/>
  <!-- 顶级组织机构Id -->
  <add key="Top_OrganizeId" value="d8ee85f8-d8d1-4b5c-bd9e-1761f44242d8"/>
  <!-- 应用Id -->
  <add key="AppId" value="CIS"/>
  <add key="AppName" value="医疗云医护协同工作站"/>

  <!-- 静态站点的Host -->
  <add key="SiteStaticHost" value="http://localhost:8014/"/>
  <!-- 日志服务的Url 废弃-->
  <add key="His.Log.URL" value="http://59.80.30.157:20106/"/>

  <!-- 登录时是否显示验证码 -->
  <add key="Is_CheckChkCode" value="false"/>
  <!-- 本地文件默认路径 -->
  <add key="LocalFileBaseDir" value="C:\\"/>

  <!-- 报表服务器 Host http://59.80.30.157:20116 废弃/-->
  <add key="ReportServer.HOST" value="http://192.168.9.190:8000/"/>

  <!-- 单点登录首页url 废弃-->
  <add key="SSOHomeHost" value="http://192.168.9.190:8005/Home/Index"/>
  <!-- 单点登出url 废弃-->
  <add key="SSOOutLogin" value="http://192.168.9.190:8005/Login/OutLogin"/>

  <!--结算接口api -->
  <add key="SiteSettAPIHost" value="http://localhost:7002/"/>
  <!--后台接口api -->
  <add key="SiteBaseAPIHost" value="http://localhost:7001/"/>
  <!--药房药库接口api -->
  <add key="SiteYfykAPIHost" value="http://localhost:7004/"/>
  <!--手术接口api 未使用-->
  <add key="SiteORAPIHost" value="http://localhost:7006/"/>
 <!--物资接口api 未使用-->
  <add key="SiteHerpAPIHost" value="http://localhost:7005/"/>

  <!-- 页面domain（嵌套其他域页面，并执行js 要设置成同一域）-->
  <add key="Document_Domain" value="localhost"/>
  <!-- API地址-统一授权用户身份换取 SettApi内网地址-->
  <add key="UAUserInfoGetAPI" value="http://localhost:7002/api/UA/GetUserInfo"/>
  <!-- Sett地址配置（统一授权登录配置）（Sett.Web外网地址） -->
  <add key="Sett_UALoginAddress" value="http://127.0.0.1:8002/Login/UALogin"/>

  <!-- 门诊开立处方，待就诊患者查询API预热链接（结算系统API内网地址） -->
  <add key="UAOutPatientRegistrationQueryPreAPI" value="http://127.0.0.1:7002/api/UA/OutPatientRegistrationQueryPre"/>

  <!-- ================== 3：住院电子病历配置 ================== -->
  <!-- EMR地址配置（统一授权登录配置）（EMR.Web外网地址） -->
  <add key="EMR_UALoginAddress" value="http://127.0.0.1:8005/Login/UALogin"/>

  <add key="vs:EnableBrowserLink" value="false"/>
  <!--ESB调用 废弃-->
  <add key="yysz_esbBM" value="EBD61E2D-1AE6-4162-92B4-FBC3D63C10CE"/>

  <!--高峰ESB调用 废弃-->
  <add key="yysz_hyfqURL" value="http://10.207.33.20:8080/Login.aspx"/>

  <!--卫计委规定的各个医院的机构编码-->
  <!--<add key="OrganizeCodeSd" value="43010112005"/>-->
  <!--远程医疗会诊报告URL 废弃-->
  <add key="RemoteTreatRPTURL" value="http://10.207.33.22:8080/TMS/consReport/viewReportInfo.html"/>

  <!--中医远程医疗平台  start 废弃-->

  <add key="IntegratedModuleUrl" value="http://cas.sinosoft.com.cn:7002/tcmpms/getPageUrl/http?resource=" />
  <!--中医远程医疗平台  end-->
  <!--是否连接手术系统-->
  <add key="EnableLinkToOR" value="true"/>
  <!--医保审核接口 医保中心端给医院分配的医院编码和名称-->
  <add key="OrganizeCodeSd" value="43010112005"/>
  <add key="HospitalName" value="测试医院"/>
  <!--报表服务器ip-->
  <add key="ReportUrl" value="http://localhost:8000/"/>
  <add key="ReportSystemCode" value="CIS"/>

  <!-- ================== 4：接口中心配置 ================== -->
  <!-- 接口中心地址 -->
  <add key="Token_ApiManage" value="API.Manage"/>
  <add key="SiteTokenAPIHost" value="http://localhost:8015/"/>
  <!-- 认证中心API -->
  <add key="SiteConmonAPIHost" value="http://localhost:8016/"/>

  <!-- 此配置废弃 -->
  <add key="OuterMediaMeettingAPIHost" value="http://localhost:8025/"/>
  <add key="SiteNoticeCenterHost" value="http://localhost:8011/"/>
  <!-- 外部PACS接口 -->
  <add key="OuterPacsServiceHost" value="http://36.137.36.185:7102"/>

  <!-- 登录页显示文字机构编码 -->
  <add key="loginybshowcode" value="机构编码：H10000000"/>
  <!-- 登录页显示文字机构名称 -->
  <add key="loginybshowname" value="机构名称：开源医疗"/>
</appSettings>