
@{
    ViewBag.Title = "采购单明细";
    Layout = "~/Views/Shared/_Form.cshtml";
    var from = (ViewBag.from as string) ?? "";
}
<style>
    .table-responsive {
        border: 0;
    }

    .ui-jqgrid .ui-jqgrid-pager .ui-pager-table {
        width: 90%;
    }
</style>
<form id="formPatSer" style="margin:2px;margin-top:10px;">
    <div class="gridPanel">
        <table id="GridList" rel="formPatSer"></table>
        <div id="gridPager" style="padding-right:20%"></div>
    </div>
</form>

<script>
    var subOrderNo = $.request("subOrderNo");//采购Id;
    $(function () {
        gridList();
    });

    function gridList() {
        var $gridList = $("#GridList");
        $gridList.dataGrid({
            url: "/BillManage/PurchasingOrder/SelectCgOrderDetail",
            height: $(window).height() - 80,
            postData: { subOrderNo: subOrderNo},
            colModel: [
                { label: '名称', name: 'wzmc', width: 80, align: 'center' },
                { label: '采购数量', name: 'slStr', width: 70, align: 'center' },
                { label: '规格', name: 'gg', width: 70, align: 'center' },
                { label: '进价', name: 'jjStr', width: 70, align: 'center' },
                { label: '进价总额', name: 'jjze', width: 70, align: 'center' },
                { label: '厂家', name: 'sccj', width: 160, align: 'center' },
                { label: '供应商', name: 'gysmc', width: 150, align: 'left' },
                { label: '发票号', name: 'fph', width: 120, align: 'left' ,hidden:true},
            ],

            multiselect: false,
            pager: "#gridPager",
            sortname: 'CreateTime',
            viewrecords: true,
            rowNum: 100,
        });
    }
</script>


